# Copy to .env and adjust for your machine.
NODE_ENV=development
PORT=4000

# PostgreSQL connection string (Neon in production, e.g. ...?sslmode=require)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/campusfix
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/campusfix_test

# Long random string used to sign access tokens (generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=7

# Front-end origin allowed by CORS during development
CLIENT_ORIGIN=http://localhost:5173

# Optional: e-mail notifications (leave blank to use in-app notifications only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CampusFix <no-reply@campusfix.app>
